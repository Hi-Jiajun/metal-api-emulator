+impl From<&DeviceContext> for ComputeDeviceLimits {
+    fn from(context: &DeviceContext) -> Self {
+        Self {
+            local_size: context.features.max_compute_workgroup_size,
+            local_invocations: context.features.max_compute_workgroup_invocations,
+            group_count: context.max_compute_workgroup_count,
+            push_constants_size: context.max_push_constants_size,
+            storage_buffer_range: context.max_storage_buffer_range,
+            storage_buffer_descriptors: context.max_compute_storage_buffers,
+        }
+    }
