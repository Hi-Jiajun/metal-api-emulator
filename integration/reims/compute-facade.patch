+fn validate_group_count(
+    region: usize,
+    group_count: [u32; 3],
+    limits: ComputeDeviceLimits,
+) -> Result<(), DrawError> {
+    for (dimension, requested) in group_count.into_iter().enumerate() {
+        let maximum = limits.group_count[dimension];
+        if requested > maximum {
+            return Err(DrawError::ComputeValidation(
+                ComputeValidationDecline::DispatchGroupCountLimit {
+                    region,
+                    dimension,
+                    requested,
+                    maximum,
+                },
+            ));
+        }
+    }
+    Ok(())
+}
+
+fn validate_compute_device_limits(
+    req: &ComputeRequest,
+    limits: ComputeDeviceLimits,
+) -> Result<(), DrawError> {
+    match &req.dispatch {
+        ComputeDispatch::Workgroups(group_count) => {
+            validate_group_count(0, *group_count, limits)?;
+        }
+        ComputeDispatch::Regions {
+            push_offset,
+            regions,
+            ..
+        } => {
+            let push_end = push_offset.checked_add(COMPUTE_DISPATCH_PUSH_CONSTANT_SIZE);
+            if push_offset % 4 != 0
+                || push_end.is_none()
+                || push_end.is_some_and(|end| end > limits.push_constants_size)
+            {
+                return Err(DrawError::ComputeValidation(
+                    ComputeValidationDecline::DispatchPushConstantLimit {
+                        offset: *push_offset,
+                        size: COMPUTE_DISPATCH_PUSH_CONSTANT_SIZE,
+                        maximum: limits.push_constants_size,
+                    },
+                ));
+            }
+            for (region_index, region) in regions.iter().enumerate() {
+                for (dimension, requested) in region.local_size.into_iter().enumerate() {
+                    let maximum = limits.local_size[dimension];
+                    if requested > maximum {
+                        return Err(DrawError::ComputeValidation(
+                            ComputeValidationDecline::DispatchLocalSizeLimit {
+                                region: region_index,
+                                dimension,
+                                requested,
+                                maximum,
+                            },
+                        ));
+                    }
+                }
+                let invocations = region
+                    .local_size
+                    .into_iter()
+                    .try_fold(1_u64, |total, dimension| {
+                        total.checked_mul(u64::from(dimension))
+                    })
+                    .unwrap_or(u64::MAX);
+                if invocations > u64::from(limits.local_invocations) {
+                    return Err(DrawError::ComputeValidation(
+                        ComputeValidationDecline::DispatchInvocationLimit {
+                            region: region_index,
+                            requested: invocations,
+                            maximum: limits.local_invocations,
+                        },
+                    ));
+                }
+                validate_group_count(region_index, region.group_count, limits)?;
+            }
+        }
