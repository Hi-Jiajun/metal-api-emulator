+    let descriptor_count = u64::try_from(req.storage_buffers.len()).unwrap_or(u64::MAX);
+    if descriptor_count > u64::from(limits.storage_buffer_descriptors) {
+        return Err(DrawError::ComputeValidation(
+            ComputeValidationDecline::StorageBufferDescriptorLimit {
+                requested: descriptor_count,
+                maximum: limits.storage_buffer_descriptors,
+            },
+        ));
+    }
+    for buffer in &req.storage_buffers {
+        let requested = u64::try_from(buffer.bytes.len()).unwrap_or(u64::MAX);
