; 本文件是 solid_unorm8_dual.frag.spv 的可读源，由渲染轨道的 include_bytes! 内嵌
; （crates/metal-api-vulkan/src/render.rs、crates/metal-api-vulkan/tests/render_e2e.rs）。
; 复现命令：
;   spirv-as --target-env vulkan1.0 solid_unorm8_dual.frag.spvasm -o solid_unorm8_dual.frag.spv
;   spirv-val --target-env vulkan1.0 solid_unorm8_dual.frag.spv
; 来源：solid_unorm8.frag.spvasm 的 MRT 扩展（v18 第 3 步，reviewed 双输出模块）。
;
; 本模块只服务 [Rgba8Unorm, Rgba8Unorm] 这一种双附件组合（v18 fixture 形状）：
; 其余双格式组合由渲染轨道 typed 拒绝（render_mrt_format_combination_unsupported）。
; 入口名沿用 fragment_main：core 的 RenderPipelineContract 拒绝 vertex/fragment
; 同名入口，所以本文件的入口名与单输出模块保持一致。
;
; 两个输出 location 各写一个固定颜色，常量沿用 solid_unorm8.frag.spvasm 的
; "字节值 / 255" 写法（0.250980407 / 0.501960814 / 0.752941191 / 1.0），
; 避开 f*255 落在半整数上的 tie（0.5*255 = 127.5 的 tie-break 实现相关）：
;   Location 0 写 (64/255, 128/255, 192/255, 1)   -> 8-bit UNORM 字节 40 80 c0 ff
;   Location 1 写 (1, 128/255, 64/255, 192/255)   -> 8-bit UNORM 字节 ff 80 40 c0
; 两个附件都是 R8G8B8A8_UNORM，"哪个通道落进哪个字节"是 VkFormat 决定的，所以
; 2x2 附件上的期望字节分别是 40 80 c0 ff 与 ff 80 40 c0 逐 texel 重复。
               OpCapability Shader
          %glsl = OpExtInstImport "GLSL.std.450"
               OpMemoryModel Logical GLSL450
               OpEntryPoint Fragment %main "fragment_main" %outColor %outColor1
               OpExecutionMode %main OriginUpperLeft
               OpSource GLSL 450
               OpName %main "fragment_main"
               OpName %outColor "outColor"
               OpName %outColor1 "outColor1"
               OpDecorate %outColor Location 0
               OpDecorate %outColor1 Location 1
       %void = OpTypeVoid
         %fn = OpTypeFunction %void
      %float = OpTypeFloat 32
    %v4float = OpTypeVector %float 4
%_ptr_Output_v4float = OpTypePointer Output %v4float
   %outColor = OpVariable %_ptr_Output_v4float Output
   %outColor1 = OpVariable %_ptr_Output_v4float Output
  %byte_64 = OpConstant %float 0.250980407
  %byte_128 = OpConstant %float 0.501960814
  %byte_192 = OpConstant %float 0.752941191
    %float_1 = OpConstant %float 1
       %main = OpFunction %void None %fn
      %entry = OpLabel
      %col_0 = OpCompositeConstruct %v4float %byte_64 %byte_128 %byte_192 %float_1
      %col_1 = OpCompositeConstruct %v4float %float_1 %byte_128 %byte_64 %byte_192
               OpStore %outColor %col_0
               OpStore %outColor1 %col_1
               OpReturn
               OpFunctionEnd
