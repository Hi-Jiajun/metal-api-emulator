; 本文件是 solid_unorm8_quad.frag.spv 的可读源，由渲染轨道的 include_bytes! 内嵌
; （crates/metal-api-vulkan/src/render.rs）。复现命令：
;   spirv-as --target-env vulkan1.0 solid_unorm8_quad.frag.spvasm -o solid_unorm8_quad.frag.spv
; 入口名 fragment_main，与其它 solid 模块一致：core 的 RenderPipelineContract 拒绝
; vertex/fragment 同名入口，而渲染管线的片元入口由 reviewed 模块给出。
;
; 片元着色器：写四个颜色位置，每个位置的颜色都在 64/255 的整数倍上（避 f*255 的半整数 tie），
; 四个字节串互不相同（40 80 c0 ff / ff 80 40 c0 / c0 40 ff 80 / 80 c0 40 ff），
; 这样"四个目标都写了"才可证伪：只写一个或写错位置的 capture 会被比较器拒。
               OpCapability Shader
          %glsl = OpExtInstImport "GLSL.std.450"
               OpMemoryModel Logical GLSL450
               OpEntryPoint Fragment %main "fragment_main" %outColor %outColor1 %outColor2 %outColor3
               OpExecutionMode %main OriginUpperLeft
               OpSource GLSL 450
               OpName %main "fragment_main"
               OpName %outColor "outColor"
               OpName %outColor1 "outColor1"
               OpName %outColor2 "outColor2"
               OpName %outColor3 "outColor3"
               OpDecorate %outColor Location 0
               OpDecorate %outColor1 Location 1
               OpDecorate %outColor2 Location 2
               OpDecorate %outColor3 Location 3
       %void = OpTypeVoid
         %fn = OpTypeFunction %void
      %float = OpTypeFloat 32
    %v4float = OpTypeVector %float 4
%_ptr_Output_v4float = OpTypePointer Output %v4float
   %outColor = OpVariable %_ptr_Output_v4float Output
   %outColor1 = OpVariable %_ptr_Output_v4float Output
   %outColor2 = OpVariable %_ptr_Output_v4float Output
   %outColor3 = OpVariable %_ptr_Output_v4float Output
  %byte_64 = OpConstant %float 0.250980407
  %byte_128 = OpConstant %float 0.501960814
  %byte_192 = OpConstant %float 0.752941191
    %float_1 = OpConstant %float 1
       %main = OpFunction %void None %fn
      %entry = OpLabel
      %col_0 = OpCompositeConstruct %v4float %byte_64 %byte_128 %byte_192 %float_1
      %col_1 = OpCompositeConstruct %v4float %float_1 %byte_128 %byte_64 %byte_192
      %col_2 = OpCompositeConstruct %v4float %byte_192 %byte_64 %float_1 %byte_128
      %col_3 = OpCompositeConstruct %v4float %byte_128 %byte_192 %byte_64 %float_1
               OpStore %outColor %col_0
               OpStore %outColor1 %col_1
               OpStore %outColor2 %col_2
               OpStore %outColor3 %col_3
               OpReturn
               OpFunctionEnd
